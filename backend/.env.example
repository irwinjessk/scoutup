# Copier vers .env pour le développement local :
#   cp .env.example .env
#
# Ne jamais committer le fichier .env (secrets).

SECRET_KEY=change-me-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# URL du frontend (liens)
# Local : http://localhost:5173
# Prod (GitHub Pages) :
FRONTEND_URL=https://irwinjessk.github.io/scoutup

# Origines CORS (sans chemin !). Sur Render, définir explicitement :
# CORS_ALLOWED_ORIGINS=https://irwinjessk.github.io,http://localhost:5173,http://127.0.0.1:5173
# CSRF_TRUSTED_ORIGINS=https://irwinjessk.github.io,http://localhost:5173,http://127.0.0.1:5173
#
# Sinon le code autorise déjà github.io + localhost via FRONTEND_URL.

# Postgres local
DB_NAME=scoutup_db
DB_USER=admin
DB_PASSWORD=your-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSL_REQUIRE=False

# Sur Render : définir DATABASE_URL (fourni par le service Postgres)
# et DB_SSL_REQUIRE=True
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME

# Compte CG seed (phase de test)
DEFAULT_CG_EMAIL=cg@scoutup.local
DEFAULT_CG_PASSWORD=ChangeMeCG2026!

# OAuth — laisser vide pour désactiver
# Google Cloud Console → Identifiants → ID client OAuth (type Web)
GOOGLE_CLIENT_ID=
# TikTok Developers → Login Kit
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Redirect TikTok (à déclarer chez TikTok) :
# https://irwinjessk.github.io/scoutup/oauth/callback
# http://localhost:5173/oauth/callback
