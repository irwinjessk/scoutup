# Copier vers .env pour le développement local :
#   cp .env.example .env
#
# Seules les variables préfixées par VITE_ sont exposées au frontend.
# Ne jamais y mettre de secrets sensibles (clés privées, mots de passe).

# URL de l'API backend
VITE_API_URL=http://localhost:8000

# Nom de l'application
VITE_APP_NAME=ScoutUp
